#VRML V2.0 utf8

# Dimensioned, through-board capacitive-touch FPC for EastRising
# ER-TPC028-4.1.  Two 90-degree bends take the tail down through the PCB
# opening and then flat along the opposite side so its connector landing
# position can be evaluated on the OpenRemote PCB.
# Manufacturer drawing dimensions used:
#   module-edge to FPC tip: 37.90 mm
#   component area: 9.00 mm wide x 13.20 mm long
#   terminal/stiffener: 4.50 mm wide x 5.00 mm long
#   six conductors: 0.50 mm pitch, 0.30 mm width, 3.50 mm exposed length
# Geometry coordinates are millimetres. The KiCad model entry applies a
# 0.393700787 scale because one native KiCad VRML unit represents 2.54 mm.

Transform {
  children [
    # First and second 90-degree bend envelope through the PCB opening.
    Transform {
      translation -16.30 -34.65 -0.10
      children [
        Shape {
          appearance DEF FLEX Appearance {
            material Material {
              diffuseColor 1.0 0.52 0.02
              ambientIntensity 0.35
              specularColor 0.15 0.08 0.0
              shininess 0.12
            }
          }
          geometry Box {
            size 9.00 0.30 5.60
          }
        }
      ]
    }
    Transform {
      translation -16.30 -28.05 -2.90
      children [
        Shape {
          appearance USE FLEX
          geometry Box {
            size 9.00 13.20 0.30
          }
        }
      ]
    }
    # The drawing shows no diagonal dog-leg: the 4.50 mm connector tail is
    # centred directly on the 9.00 mm component area.
    Transform {
      translation -16.30 -9.10 -2.90
      children [
        Shape {
          appearance USE FLEX
          geometry Box {
            size 4.50 24.70 0.30
          }
        }
      ]
    }
    Transform {
      translation -16.30 0.75 -2.90
      children [
        Shape {
          appearance USE FLEX
          geometry Box {
            size 4.50 5.00 0.30
          }
        }
      ]
    }
    Transform {
      translation -16.30 0.75 -3.07
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.88 0.70 0.20
              ambientIntensity 0.4
              shininess 0.15
            }
          }
          geometry Box {
            size 4.50 5.00 0.04
          }
        }
      ]
    }
    Transform { translation -15.05 1.50 -3.10 children [ Shape { appearance DEF GOLD Appearance { material Material { diffuseColor 1.0 0.82 0.18 specularColor 0.35 0.25 0.05 shininess 0.3 } } geometry Box { size 0.30 3.50 0.04 } } ] }
    Transform { translation -15.55 1.50 -3.10 children [ Shape { appearance USE GOLD geometry Box { size 0.30 3.50 0.04 } } ] }
    Transform { translation -16.05 1.50 -3.10 children [ Shape { appearance USE GOLD geometry Box { size 0.30 3.50 0.04 } } ] }
    Transform { translation -16.55 1.50 -3.10 children [ Shape { appearance USE GOLD geometry Box { size 0.30 3.50 0.04 } } ] }
    Transform { translation -17.05 1.50 -3.10 children [ Shape { appearance USE GOLD geometry Box { size 0.30 3.50 0.04 } } ] }
    Transform { translation -17.55 1.50 -3.10 children [ Shape { appearance USE GOLD geometry Box { size 0.30 3.50 0.04 } } ] }
  ]
}
